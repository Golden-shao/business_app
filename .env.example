# Copy to .env and replace both values with DIFFERENT random tokens (16+ chars).
ADMIN_TOKEN=replace-with-a-random-admin-token
GATEWAY_TOKEN=replace-with-a-different-client-token
REDIS_URL=redis://localhost:6379/0
PROVIDER=mock
# Opt-in, mock-only anonymous website demo; never enable paid providers with it.
PUBLIC_DEMO_ENABLED=false
RATE_LIMIT_PER_MINUTE=30
CACHE_TTL_SECONDS=60
# Optional real OpenAI-compatible provider (no streaming in v0.1).
# PROVIDER=openai-compatible
# UPSTREAM_BASE_URL=https://api.openai.com/v1
# UPSTREAM_API_KEY=
# UPSTREAM_MODEL=
